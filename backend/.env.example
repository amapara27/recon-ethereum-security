# Blockchain RPC URL (Infura or Alchemy) — code reads ALCHEMY_RPC_URL
# Get free tier at: https://infura.io/ or https://www.alchemy.com/
ALCHEMY_RPC_URL='https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY'

# Etherscan API Key for transaction history
# Get free tier at: https://etherscan.io/apis
ETHERSCAN_API_KEY='YOUR_ETHERSCAN_KEY'

# Anthropic API Key for AI-powered smart contract analysis
# Get API access at: https://console.anthropic.com/
ANTHROPIC_API_KEY='YOUR_ANTHROPIC_KEY'